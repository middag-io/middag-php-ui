# Dependencies
/node_modules/
/vendor/
composer.lock

# Environment variables
.env*
!.env.example
!.env.tpl

# UI configuration
ui*/dist
ui*/.npmrc

# Tool caches (all in .cache/ — keeps root clean)
.cache/
.idea/
.venv/
.php-cs-fixer.cache
.phpunit.result.cache
.phpunit.cache/
__pycache__/
logs/

# VitePress
docs/.vitepress/dist/
docs/.vitepress/cache/
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/
docs-site/.vitepress/.temp/

# VIGIM operational state (ADR-925 - local_middag)
# Versioned: all .vigim/ except data/
# Ephemeral: .vigim/content/data/ (inventory, snapshots, reports, cache)
.vigim/content/data/*
!.vigim/content/data/.gitkeep
!.vigim/content/data/*.csv

