{
    "name": "middag-io/ui",
    "description": "MIDDAG UI contract builders — transport-agnostic PageContract system for contract-driven rendering",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["ui", "contract-builder", "inertia", "form", "page-contract", "transport-agnostic"],
    "homepage": "https://github.com/middag-io/middag-php-ui",
    "authors": [
        {
            "name": "Michael Meneses",
            "email": "michael@middag.io",
            "homepage": "https://middag.io",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/middag-io/middag-php-ui/issues",
        "source": "https://github.com/middag-io/middag-php-ui",
        "security": "https://github.com/middag-io/middag-php-ui/security/policy"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Middag\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Middag\\Ui\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text",
        "check:boundaries": "grep -rln --include='*.php' 'Middag\\\\Core\\\\' src && { echo 'Article-I VIOLATION: OSS adapter src/ imports a non-OSS MIDDAG namespace/package, which is forbidden'; exit 1; } || echo 'boundaries OK: no non-OSS MIDDAG namespace imports in src/'",
        "check:style": "php-cs-fixer fix --dry-run --verbose --config=.php-cs-fixer.dist.php",
        "check:rector": "rector process --dry-run --config=.php-rector.php",
        "check:stan": "phpstan analyse --configuration=.phpstan.neon",
        "check:schemas": "@php bin/emit-schemas.php --check",
        "lint:php82": "bin/lint-php82.sh",
        "emit:schemas": "@php bin/emit-schemas.php",
        "verify:schemas": "@php bin/emit-schemas.php --check",
        "check": [
            "@check:boundaries",
            "@check:style",
            "@check:rector",
            "@check:stan",
            "@check:schemas"
        ],
        "fix:style": "php-cs-fixer fix --verbose --show-progress=none --config=.php-cs-fixer.dist.php",
        "fix:rector": "rector process --config=.php-rector.php --no-progress-bar",
        "fix": [
            "@fix:style",
            "@fix:rector"
        ],
        "fix:all": [
            "@fix:style",
            "@fix:rector",
            "@fix:style"
        ],
        "post-install-cmd": "git config core.hooksPath .githooks 2>/dev/null || true",
        "post-update-cmd": "git config core.hooksPath .githooks 2>/dev/null || true"
    }
}