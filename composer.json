{
    "name": "middag-io/ui",
    "description": "MIDDAG UI contract builders — transport-agnostic PageContract system for contract-driven rendering",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Middag\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Middag\\Ui\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
